# Copy this file to .env and fill in your local Neo4j and PostgreSQL credentials.
# .env is git-ignored; never commit real credentials.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# PostgreSQL application database (Day 11). POSTGRES_TEST_DB is a separate,
# disposable database used only by opt-in live tests -- never the main one.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hirewise
POSTGRES_USER=hirewise_app
POSTGRES_PASSWORD=changeme
POSTGRES_TEST_DB=hirewise_test

# Flask session signing key (Day 12). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app uses a temporary random key and logins end on restart.
FLASK_SECRET_KEY=change-me-to-a-long-random-value
# Set to 1 only when HireWise is served over HTTPS (secure session cookies).
HIREWISE_SECURE_COOKIES=0
