# Copy this file to .env and fill in your local Neo4j and PostgreSQL credentials.
# .env is git-ignored; never commit real credentials.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# PostgreSQL application database (Day 11). POSTGRES_TEST_DB is a separate,
# disposable database used only by opt-in live tests -- never the main one.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hirewise
POSTGRES_USER=hirewise_app
POSTGRES_PASSWORD=changeme
POSTGRES_TEST_DB=hirewise_test

# Flask session signing key (Day 12). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app uses a temporary random key and logins end on restart.
FLASK_SECRET_KEY=change-me-to-a-long-random-value
# Set to 1 only when HireWise is served over HTTPS (secure session cookies).
HIREWISE_SECURE_COOKIES=0

# ---- Email delivery (pre-deployment Milestone 1: email verification + password reset) ----
# Production needs MAIL_BACKEND=smtp and the SMTP_* / MAIL_FROM / APP_BASE_URL settings below; the app
# refuses to start the marketplace in production without a valid email configuration.
# Local runs: MAIL_BACKEND=console (prints emails to the terminal) or file (writes .eml files to
# MAIL_OUTBOX_DIR, which must be OUTSIDE this repository; default: <system temp>/hirewise-outbox).
MAIL_BACKEND=console
# Public address of the site, used to build the links in emails (never taken from request headers).
# Must be https in production (http is accepted only for localhost).
APP_BASE_URL=http://127.0.0.1:5000
MAIL_FROM=HireWise <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
# 1 = STARTTLS (port 587), ssl = implicit TLS (port 465), 0 = plain SMTP (local relay only; refused in production)
SMTP_USE_TLS=1
# MAIL_OUTBOX_DIR=C:\path\outside\the\repository\hirewise-outbox

# Number of reverse proxies in front of HireWise whose X-Forwarded-For/-Proto headers are trusted
# (client address for rate limiting). Leave 0 unless exactly that many proxies you control set them.
HIREWISE_TRUSTED_PROXIES=0

# ---- Continue with Google (pre-deployment Milestone 2; optional) ----
# OAuth 2.0 client ("Web application") from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI to register there: <APP_BASE_URL>/auth/google/callback
#   (e.g. http://127.0.0.1:5000/auth/google/callback locally; https://<your-domain>/auth/google/callback in production).
# Leave BOTH unset to hide the "Continue with Google" button; setting only one of them stops start-up.
# GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=change-me

# ---- Notifications and demo mode (pre-deployment Milestone 3) ----
# The header bell refreshes its unread count this often (seconds, minimum 5) while the tab is visible.
HIREWISE_NOTIFICATIONS_POLL_SECONDS=30
# Notification emails are never sent to addresses in these comma-separated domains (the demo accounts use demo.local).
HIREWISE_NOTIFICATION_EMAIL_SKIP_DOMAINS=demo.local
# Demo mode: the demo operator account answers bookings for catalogue workers that have no linked account.
# Create it with: python scripts/create_demo_account.py --demo-operator --email operator@example.com --name "HireWise Demo"
# With demo mode on but the operator missing or invalid, the app logs a warning and keeps demo mode off.
HIREWISE_DEMO_MODE=0
# HIREWISE_DEMO_OPERATOR_EMAIL=operator@example.com
# At most this many demo-operator emails per UTC day (in-app notifications continue above it).
HIREWISE_DEMO_OPERATOR_EMAIL_DAILY_CAP=50

# ---- Profiles and self-reported credentials (pre-deployment Milestone 4) ----
# No settings: the bio length, credentials per kind and avatar palette size are code configuration (src/app/config.py).
